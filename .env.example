# 复制为 .env 后填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，切勿提交真实凭证。

# ---- AI 多模态模型 ----
# 用哪一个由 config.yaml 的 `ai.api_key_env` 决定。默认 provider=deepseek。
DEEPSEEK_API_KEY=

# 换成 Claude / OpenAI / 通义 时，取消注释并在 config.yaml 同步 ai.api_key_env 与 ai.provider
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DASHSCOPE_API_KEY=

# ---- 钉钉：企业内部应用（Stream 长连接接收指令 + 机器人单聊推送照片/报告）----
# 开放平台 → 应用开发 → 企业内部应用 → 凭证与基础信息
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
# 机器人编码（开放平台 → 应用 → 机器人 → 机器人 ID）
DINGTALK_ROBOT_CODE=

# ---- 钉钉：自定义机器人 webhook（可选，只能发群，且图片必须公网可访问）----
# 家庭内网无公网 IP 时配了也发不出图片，默认留空。
# DINGTALK_WEBHOOK=
# DINGTALK_SECRET=
